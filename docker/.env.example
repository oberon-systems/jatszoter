# Copy next to compose.yaml and fill it in: cp env.example .env
# Compose reads these itself; the containers get only what compose.yaml passes on.

# Images. A jatszoter release pins both in its compose.yaml; set them only to
# run images of your own, such as the ones `make images` builds from the tree.
# JATSZOTER_API_IMAGE=jatszoter-api:dev
# JATSZOTER_WEB_IMAGE=jatszoter-web:dev

# Where the two ports are published. 127.0.0.1 keeps them on this host; put a
# reverse proxy with TLS in front before agents or browsers on other hosts use
# them (docs/project/10-reverse-proxy.md).
JATSZOTER_BIND=127.0.0.1
JATSZOTER_API_PORT=8080
JATSZOTER_WEB_PORT=8000

# Postgres. The password ends up inside the connection URL, so keep it to
# URL-safe characters; a hex string is:
#   openssl rand -hex 24
JATSZOTER_DB_NAME=jatszoter
JATSZOTER_DB_USER=jatszoter
JATSZOTER_DB_PASSWORD=

# Valkey holds leases, nonces and login counters, and is never published.
# Its password sits in a URL too:
#   openssl rand -hex 24
JATSZOTER_VALKEY_PASSWORD=

# The key the API signs every SeaweedFS filer call with, and the filer checks:
#   openssl rand -hex 32
JATSZOTER_SEAWEED_JWT_KEY=

# The master keys every credential key derives from, as JSON by kid, and the
# kid new credentials use. A kid is letters and digits; a key is 32 bytes as hex:
#   openssl rand -hex 32
# To rotate, add a second kid, switch JATSZOTER_MASTER_KID to it, and drop the
# old one once every credential issued under it has expired.
JATSZOTER_MASTER_KEYS='{"k1": ""}'
JATSZOTER_MASTER_KID=k1

# The stack's own network. The API trusts X-Forwarded-For from all of it: web
# passes the browser's address on, and a proxy on this host comes in through the
# gateway. web trusts it from the gateway alone, the first address of the subnet.
# Pick another subnet if this one is taken, and move the gateway with it.
JATSZOTER_SUBNET=172.31.250.0/24
JATSZOTER_WEB_FORWARDED_ALLOW_IPS=172.31.250.1

# true lets a new agent in without an operator approving it in the web UI.
JATSZOTER_AUTO_REGISTER_AGENTS=false

# The keys web seals its cookies with, as JSON by kid, and the kid in use.
# A kid is letters and digits; a key is 32 random bytes as unpadded base64url:
#   python3 -c 'import base64, secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).rstrip(b"=").decode())'
JATSZOTER_WEB_COOKIE_KEYS='{"c1": ""}'
JATSZOTER_WEB_COOKIE_KID=c1
